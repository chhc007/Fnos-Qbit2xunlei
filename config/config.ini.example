# qBit → 迅雷 自动转存配置文件

[qbittorrent]
QB_HOST = http://192.168.1.100:8080
QB_USER = admin
QB_PASS = adminadmin

[nas]
NAS_HOST = 192.168.1.100
NAS_PORT = 5666
NAS_USER = admin
NAS_PASS = admin

# 迅雷下载路径（留空使用迅雷默认路径）
XUNLEI_DOWNLOAD_PATH =

# qBit 保存路径前缀 → 映射到迅雷路径
# qBit /downloads/电影/动画电影 → 迅雷 /存储空间5/.../迅雷下载影视/电影/动画电影
QBIT_SAVE_PATH_PREFIX =
XUNLEI_BASE_PATH =

[general]
# --- 基础 ---
CHECK_INTERVAL = 10
TARGET_LABEL = 迅雷
DELETE_FILES = false

# --- 预检查：先看 qBit 速度，够快就不转迅雷 ---
# 发现带迅雷标签的任务后，等待这段时间观察 qBit 速度（秒）
PRE_CHECK_WAIT = 20
# qBit 平均速度 >= 此值（KB/s）则认为不需要转迅雷，移除标签
PRE_CHECK_SPEED_THRESHOLD = 2000

# --- 转存后比速 ---
SPEED_CHECK_DURATION = 40
SPEED_CHECK_INTERVAL = 5
INITIAL_WAIT = 10
MIN_SPEED_BYTES = 50

# --- 0速度超时清理 --- 清理两个下载器里完全没速度的任务 超时时间单位分钟
ZERO_SPEED_ENABLED = false
ZERO_SPEED_TIMEOUT = 120

# --- 文件过滤 --- 迅雷下载时过滤非视频和nfo和字幕文件
FILTER_FILES = true

# --- 并发限制 --- 迅雷「同时下载任务数」上限
# 迅雷同时下载任务数有上限，超出上限的任务会排队等待（表现为 0 速度）。
# 排队任务不会被误判为卡死，但为避免大量任务同时排队，可在此设置上限：
# 当迅雷活动任务数（下载中+排队中）达到该值时，先等待有空位再提交新任务。
# 0 = 不限制（保持旧行为）
MAX_CONCURRENT_TASKS = 0
# 队列轮询间隔（秒）：并发已满时，隔多久检查一次是否有空位
QUEUE_POLL_INTERVAL = 30
# 排队最长等待（分钟）：超过则跳过本轮，保留 qBit 任务与标签，下轮重试
QUEUE_MAX_WAIT_MINUTES = 60

# --- 调试模式 --- 开启后打印所有API请求/响应详情，用于排查问题
DEBUG = false

# --- 任务读取/创建方式 ---
# api（默认，推荐）：全部走迅雷 HTTP 接口，快且无浏览器依赖
# playwright：旧实现，用无头浏览器操作网页（已废弃，仅作兜底）
TASK_SOURCE = api
